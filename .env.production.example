# Copy to a protected file outside Git; replace every placeholder before deployment.
# Generate independent hex secrets: python -c "import secrets; print(secrets.token_hex(32))"
# Use hex for POSTGRES_PASSWORD to avoid URL-encoding ambiguity.
APP_IMAGE=armeniabus-api:release-replace-this
API_DOMAIN=api.example.invalid
POSTGRES_DB=armeniabus
POSTGRES_USER=armeniabus
POSTGRES_PASSWORD=replace-this
POSTGRES_APP_PASSWORD=replace-this-with-an-independent-secret
JWT_SECRET_KEY=replace-this
CORS_ORIGINS=["https://example.invalid"]
PAYMENTS_ENABLED=false
YOOKASSA_TEST_MODE=true
NOTIFICATIONS_ENABLED=false
WORKER_STALE_SECONDS=600
# Choose a free subnet and an address in it if this overlaps the host network.
EDGE_SUBNET=172.30.10.0/24
PROXY_IP=172.30.10.2
