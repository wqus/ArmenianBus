# Local development only. Replace these values for any shared environment.
POSTGRES_DB=armeniabus
POSTGRES_USER=armeniabus
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+asyncpg://armeniabus:change-me-local@localhost:5432/armeniabus
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
APP_ENV=development
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
REQUEST_MAX_BYTES=65536
REQUEST_BODY_TIMEOUT_SECONDS=10
WORKER_STALE_SECONDS=600
BOOKING_HOLD_MINUTES=10
PAID_CANCELLATION_CUTOFF_HOURS=24
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_POLL_SECONDS=5
NOTIFICATION_RETRY_SECONDS=30
NOTIFICATION_MAX_ATTEMPTS=8
HOLD_WORKER_INTERVAL_SECONDS=5
HOLD_WORKER_BATCH_SIZE=500
PAYMENTS_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true
PAYMENT_RETURN_URL=http://localhost:5173/payment/result
JWT_SECRET_KEY=replace-this-with-a-random-local-secret-of-at-least-32-characters
