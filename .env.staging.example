# Same hardened stack as production, with separate domain, project, volumes and secrets.
# Run with: -p armeniabus-staging -f compose.production.yaml --env-file /secure/staging.env
APP_IMAGE=armeniabus-api:release-replace-this
WEB_IMAGE=armeniabus-web:release-replace-this
APP_DOMAIN=staging.example.invalid
POSTGRES_DB=armeniabus_staging
POSTGRES_USER=armeniabus
POSTGRES_PASSWORD=replace-this-with-an-independent-secret
POSTGRES_APP_PASSWORD=replace-this-with-another-independent-secret
JWT_SECRET_KEY=replace-this
PAYMENTS_ENABLED=false
YOOKASSA_TEST_MODE=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
NOTIFICATIONS_ENABLED=false
# Implicit TLS (SMTP_SSL), usually 465; STARTTLS/587 is not implemented.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional exact HTTPS site origin for account links; production Compose derives APP_DOMAIN.
AUTH_PUBLIC_ORIGIN=
WORKER_STALE_SECONDS=600
# Different subnet from production; use a separate host for standard 80/443 ports.
EDGE_SUBNET=172.30.20.0/24
EDGE_DYNAMIC_RANGE=172.30.20.128/25
PROXY_IP=172.30.20.2
